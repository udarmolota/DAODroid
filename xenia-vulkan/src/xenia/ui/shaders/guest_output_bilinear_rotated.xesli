// DAO: guest_output_bilinear.xesli drawing into a pre-rotated (portrait) Android
// swapchain image, so the compositor doesn't rotate every frame on the GPU. The
// rectangle and xe_bilinear_output_offset are in the physical image; the size is
// the logical (landscape) output's. XE_GUEST_OUTPUT_ROTATION is 90 (the content
// turned 90 degrees clockwise, for VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR) or 270.

#include "xesl.xesli"

push_const_begin_xe(b0, space0)
  // 16 used by the vertex shader (GLSL push constant offsets are across
  // stages).
  block_offset_member_xe(16, c0.x, int2_xe, xe_bilinear_output_offset)
  block_offset_member_xe(24, c0.z, float2_xe, xe_bilinear_output_size_inv)
push_const_end_xe

entry_outputs_begin_xe
  entry_out_target_xe(float4_xe, xe_bilinear_color, 0)
entry_outputs_end_stage_inputs_begin_xe
entry_stage_inputs_end_bindings_begin_pixel_xe
  push_const_binding_xe(buffer(0))
  entry_binding_next_xe
  texture_xe(texture_2d_xe, xe_bilinear_source, set=0, binding=0, t0, space0,
             texture(0))
  entry_binding_next_xe
  sampler_state_xe(xe_bilinear_sampler, set=0, binding=1, s0, space0,
                   sampler(0))
entry_bindings_end_inputs_begin_xe
  entry_in_pixel_coord_xe
entry_inputs_end_code_begin_xe
{
  // The pixel center within the physical rectangle (.5 fractions kept).
  float2_xe local = in_pixel_coord_xe.xy -
                    float2_xe(push_const_xe(xe_bilinear_output_offset));
  float2_xe size_inv = push_const_xe(xe_bilinear_output_size_inv);
  float2_xe logical;
  #if XE_GUEST_OUTPUT_ROTATION == 90
    // Clockwise: physical (x', y') = (h - 1 - y, x).
    logical = float2_xe(local.y, 1.0f / size_inv.y - local.x);
  #else
    // 270: physical (x', y') = (y, w - 1 - x).
    logical = float2_xe(1.0f / size_inv.x - local.y, local.x);
  #endif
  float4_xe bilinear_color;
  bilinear_color.rgb =
      sample_sep_lod_2d_xe(xe_bilinear_source, xe_bilinear_sampler,
                           logical * size_inv, 0.0f).rgb;
  bilinear_color.a = 1.0f;
  out_xe(xe_bilinear_color) = bilinear_color;
}
entry_code_end_xe
